{
  "compilerOptions": {
    // no se generan archivos .d.ts automáticamente al compilar el proyecto con tsc
    "declaration": true,
    "noEmit": false, // no emitir JavaScript al compilar
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": "./",
    "emitDeclarationOnly": true, // Solo emitir archivos .d.ts
    "composite": true,
    "paths": {
      "@store/*": ["src/store/*"],
      "*": ["types/*"]
    },
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./dist/module", // Alinear con la salida de bob
    "rootDir": "./src" // Directorio raíz
  },
  "include": ["types/**/*.d.ts", "src/**/*"],
  "exclude": ["node_modules", "dist"]
}
